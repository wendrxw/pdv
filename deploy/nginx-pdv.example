# Nginx — site do PDV em produção (pdv.wendrxw.online)
#
# Topologia: Cloudflare Tunnel (TLS) → Nginx :80 → gunicorn 127.0.0.1:8001.
# Como o TLS termina NO TÚNEL, o Nginx escuta apenas em 80 e encaminha
# X-Forwarded-Proto: https para o Django reconhecer requisições seguras
# (PDV_BEHIND_PROXY=True no .env).
#
# O script deploy/setup-pdv.sh instala este arquivo em
# /etc/nginx/sites-available/pdv com o domínio correto.

upstream pdv_app {
    server 127.0.0.1:8001;
}

server {
    listen 80;
    listen [::]:80;
    server_name pdv.wendrxw.online;

    client_max_body_size 5m;

    # Cabeçalhos básicos de segurança (HSTS é enviado pelo próprio Django)
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # Arquivos estáticos (collectstatic). /media/ NÃO é servido —
    # certificados A1 do fiscal nunca ficam públicos.
    location /static/ {
        alias /opt/pdv/staticfiles/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://pdv_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # TLS termina no Cloudflare Tunnel: SEMPRE https daqui para frente.
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Gzip básico
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
