# Variáveis de ambiente de produção do PDV (pdv.wendrxw.online).
# Copie para /opt/pdv/.env (chmod 600). O script deploy/setup-pdv.sh gera
# este arquivo automaticamente com segredos fortes.

# --- Django ---------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=gerar-com-python-secrets-e-manter-secreto
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=pdv.wendrxw.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://pdv.wendrxw.online

# --- Banco (PostgreSQL em produção) ----------------------------------
PDV_DB_ENGINE=postgres
PDV_DB_NAME=pdv
PDV_DB_USER=pdv
PDV_DB_PASSWORD=senha-forte-do-banco
PDV_DB_HOST=127.0.0.1
PDV_DB_PORT=5432

# --- Proxy/TLS (Cloudflare Tunnel + Nginx terminam o HTTPS) ----------
# Confia no X-Forwarded-Proto enviado pelo Nginx (gunicorn só em 127.0.0.1).
PDV_BEHIND_PROXY=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
# Só habilite HSTS em subdomínios se TODOS os subdomínios usarem HTTPS:
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=True

# --- Porta do gunicorn (systemd lê PDV_PORT) --------------------------
PDV_PORT=8001

# --- Cache (produção: file ou memcached — throttle da impressão) -------
PDV_CACHE_BACKEND=file
PDV_CACHE_DIR=/opt/pdv/.django-cache

# --- Uploads (certificado A1 — NUNCA servir via nginx) -----------------
PDV_MEDIA_ROOT=/opt/pdv/media

# --- Módulo fiscal NFC-e ---------------------------------------------
SEFAZ_UF=SP
SEFAZ_AMBIENTE=HOMOLOGACAO
# SEFAZ_CERTIFICATE_PASSWORD=<senha do certificado A1, NUNCA em logs>
