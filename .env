# Variáveis de ambiente de produção do PDV.
# Copie para /opt/pdv/.env e carregue antes do gunicorn (ou use systemd/runit Environment).

# --- Django ---------------------------------------------------------
DJANGO_SECRET_KEY=gerar-com-python-secrets-e-manter-secreto
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=pdv.sua-loja.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://pdv.sua-loja.com

# --- Banco (PostgreSQL em produção) ----------------------------------
PDV_DB_ENGINE=postgres
PDV_DB_NAME=pdv
PDV_DB_USER=pdv
PDV_DB_PASSWORD=senha-forte-do-banco
PDV_DB_HOST=127.0.0.1
PDV_DB_PORT=5432

# --- TLS/HSTS (atrás do Cloudflare Tunnel deixe SSL redirect ligado) --
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# --- Cache (produção: file ou memcached — throttle da impressão) -------
PDV_CACHE_BACKEND=file
PDV_CACHE_DIR=/opt/pdv/.django-cache

# --- Uploads (certificado A1 — NUNCA servir via nginx) -----------------
PDV_MEDIA_ROOT=/opt/pdv/media

# --- Módulo fiscal NFC-e ---------------------------------------------
SEFAZ_UF=SP
SEFAZ_AMBIENTE=HOMOLOGACAO
# SEFAZ_CERTIFICATE_PASSWORD=<senha do certificado A1, NUNCA em logs>
